{
  "name": "dsh-github-accel",
  "version": "1.0.1",
  "description": "GitHub acceleration for DeepSeek Harness: probe mirrors, rewrite GitHub URLs, and download or shallow-clone through the fastest healthy mirror.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/core.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYSTEMMBRBOOT/dsh-github-accel.git"
  },
  "homepage": "https://github.com/SYSTEMMBRBOOT/dsh-github-accel#readme",
  "bugs": {
    "url": "https://github.com/SYSTEMMBRBOOT/dsh-github-accel/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "github",
    "mirror",
    "proxy",
    "acceleration",
    "clone"
  ],
  "license": "MIT"
}
